{
  "name": "yukthimantra-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "YukthiMantra Academy multi-application enterprise monorepo",
  "workspaces": [
    "yukthimantra.com",
    "app.yukthimantra.com",
    "events.yukthimantra.com",
    "packages/*"
  ],
  "scripts": {
    "dev:main": "npm --prefix yukthimantra.com run dev",
    "dev:app": "npm --prefix app.yukthimantra.com run dev",
    "dev:events": "npm --prefix events.yukthimantra.com run dev",
    "build:main": "npm --prefix yukthimantra.com run build",
    "build:app": "npm --prefix app.yukthimantra.com run build",
    "build:events": "npm --prefix events.yukthimantra.com run build",
    "build:all": "npm run build:main && npm run build:app && npm run build:events",
    "lint:main": "npm --prefix yukthimantra.com run lint",
    "lint:app": "npm --prefix app.yukthimantra.com run lint",
    "lint:events": "npm --prefix events.yukthimantra.com run lint",
    "lint:all": "npm run lint:main && npm run lint:app && npm run lint:events"
  },
  "keywords": [
    "yukthimantra",
    "academy",
    "nextjs",
    "monorepo",
    "healthcare-ai",
    "data-science"
  ],
  "author": "YukthiMantra Academy",
  "license": "MIT"
}
