{
  "name": "yukthimantrasacademy-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "YukthiMantra Academy multi-application enterprise monorepo",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:website": "turbo run dev --filter=@yukthimantra/website",
    "dev:platform": "turbo run dev --filter=@yukthimantra/platform",
    "dev:events": "turbo run dev --filter=@yukthimantra/events",
    "dev:main": "turbo run dev --filter=@yukthimantra/website",
    "dev:app": "turbo run dev --filter=@yukthimantra/platform",
    "build": "turbo run build",
    "build:website": "turbo run build --filter=@yukthimantra/website",
    "build:platform": "turbo run build --filter=@yukthimantra/platform",
    "build:events": "turbo run build --filter=@yukthimantra/events",
    "build:all": "turbo run build",
    "build:main": "turbo run build --filter=@yukthimantra/website",
    "build:app": "turbo run build --filter=@yukthimantra/platform",
    "lint": "turbo run lint",
    "lint:all": "turbo run lint",
    "lint:main": "turbo run lint --filter=@yukthimantra/website",
    "lint:app": "turbo run lint --filter=@yukthimantra/platform",
    "lint:events": "turbo run lint --filter=@yukthimantra/events",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "yukthimantrasacademy",
    "nextjs",
    "monorepo",
    "pnpm",
    "turborepo",
    "healthcare-ai"
  ],
  "author": "YukthiMantra Academy",
  "license": "MIT"
}
